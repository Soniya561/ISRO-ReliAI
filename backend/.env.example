# ISRO-ReliAI Backend Configuration
# Copy this file to .env and customize for your environment

# Server Configuration
HOST=0.0.0.0
PORT=5000
DEBUG=False

# Frontend URL (for CORS configuration)
FRONTEND_URL=https://isro-reliai.netlify.app

# Additional CORS origins (if needed, add to config.py ALLOWED_ORIGINS list)
# LOCALHOST_3000=http://localhost:3000
# LOCALHOST_5173=http://localhost:5173

# MongoDB Configuration
# Replace with your actual MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=isro_reliai

# Model Configuration
# Set to True to use mock models when real models fail to load
USE_MOCK_MODELS=False
